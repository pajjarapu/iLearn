# Server
PORT=3001

# Simulated cooks. Set to false once real agents are wired (phase 3).
MOCK_AGENTS=true

# Used in phase 3. Mock mode does not call Anthropic.
ANTHROPIC_API_KEY=

# Dollar rates per million tokens. Defaults match Claude Sonnet: $3 in / $15 out.
PRICE_INPUT_PER_MTOK=3
PRICE_OUTPUT_PER_MTOK=15

# SQLite file. Relative paths are resolved from /server.
# DATABASE_PATH=./data/kitchen.db
